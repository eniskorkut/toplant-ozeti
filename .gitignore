# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Node / Next.js
node_modules/
.next/
out/
build/
dist/
*.tsbuildinfo
npm-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Env files (secrets; .env.example is the only tracked template)
.env
.env.*
!.env.example

# Meeting data (audio + generated artifacts)
data/meetings/*
!data/meetings/.gitkeep

# Models / caches
models/
*.ggml
*.gguf
*.onnx

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# STT benchmark caches and outputs (may contain speech content)
benchmarks/stt/.cache/
benchmarks/stt/results/latest.json
benchmarks/stt/results/latest.md
benchmarks/stt/results/runs/
benchmarks/stt/results/matrix.json
benchmarks/stt/results/matrix.md
benchmarks/stt/results/turbo-matrix.json
benchmarks/stt/results/turbo-matrix.md
benchmarks/stt/results/turbo-runs/
benchmarks/stt/results/model-metadata-small.json

# Diarization benchmark (models and outputs may contain speech content)
benchmarks/diarization/models/
benchmarks/diarization/results/latest.json
benchmarks/diarization/results/latest.md
benchmarks/diarization/results/runs/
benchmarks/diarization/reference_turns.txt
benchmarks/diarization/datasets/
benchmarks/diarization/.tools/
benchmarks/diarization/results/voxconverse.json
benchmarks/diarization/results/voxconverse.md
benchmarks/diarization/results/voxconverse-state.json
benchmarks/diarization/results/scoring/
benchmarks/merge/results/
data/*.db
data/*.db-wal
data/*.db-shm

# Real-meeting diagnostic outputs (contain transcript text)
benchmarks/real-meeting-diagnostic/output/
benchmarks/overlap-merge/results/
benchmarks/diarization-postprocess/results/

# ElevenLabs benchmark outputs (private transcripts, raw provider responses)
benchmarks/elevenlabs-stt/results/

# --- safety hardening: secrets, runtime data, audio, model assets -------------
# Whole data tree is runtime state; the tracked .gitkeep is re-included explicitly.
data/
!data/meetings/
data/meetings/*
!data/meetings/.gitkeep
data/**/*.db
data/**/*.db-wal
data/**/*.db-shm

# Any benchmark outputs that may contain speech, provider payloads or private text.
**/results/
**/private/
**/raw/

# Audio containers (never commit recordings).
*.wav
*.mp3
*.webm
*.m4a

# Model assets (whisper.cpp, sherpa-onnx, future exports).
*.onnx
*.bin
*.gguf
*.pt
*.pth
*.safetensors

# Keep the intentionally tracked safe metadata inside results directories.
# (A file can only be re-included when its parent directory is not excluded.)
!benchmarks/stt/results/
benchmarks/stt/results/*
!benchmarks/stt/results/.gitkeep
!benchmarks/stt/results/model-metadata.json
!benchmarks/stt/results/model-metadata-turbo.json
!benchmarks/diarization/results/
benchmarks/diarization/results/*
!benchmarks/diarization/results/.gitkeep
!benchmarks/diarization/results/model-metadata.json
